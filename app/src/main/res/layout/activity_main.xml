<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#1a1a1a">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dungeon Crawler"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:padding="4dp"/>

    <TextView
        android:id="@+id/statsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#CCCCCC"
        android:textSize="12sp"
        android:padding="2dp"/>

    <com.yourpackage.dungeoncrawler.ui.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button android:id="@+id/btnStats" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="📊" android:textSize="12sp"/>
        <Button android:id="@+id/btnInventory" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🎒" android:textSize="12sp"/>
        <Button android:id="@+id/btnQuests" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="📜" android:textSize="12sp"/>
        <Button android:id="@+id/btnWatchAd" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="📺" android:textSize="12sp"/>
        <Button android:id="@+id/btnSettings" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⚙️" android:textSize="12sp"/>
        <Button android:id="@+id/btnSaveLoad" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="💾" android:textSize="12sp"/>
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="3"
        android:padding="4dp">

        <Button android:id="@+id/btnUp" android:layout_row="0" android:layout_column="1" android:text="↑"/>
        <Button android:id="@+id/btnLeft" android:layout_row="1" android:layout_column="0" android:text="←"/>
        <Button android:id="@+id/btnAttack" android:layout_row="1" android:layout_column="1" android:text="⚔"/>
        <Button android:id="@+id/btnRight" android:layout_row="1" android:layout_column="2" android:text="→"/>
        <Button android:id="@+id/btnDown" android:layout_row="2" android:layout_column="1" android:text="↓"/>
        <Button android:id="@+id/btnMode" android:layout_row="2" android:layout_column="2" android:text="🧠" android:textSize="12sp"/>
    </GridLayout>

    <TextView
        android:id="@+id/narrativeLog"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#0d0d0d"
        android:padding="6dp"
        android:fontFamily="serif"
        android:textSize="11sp"
        android:textColor="#CCCCCC"
        android:text="You awaken in darkness..."
        android:scrollbars="vertical"
        android:layout_marginTop="4dp"/>

    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-3940256099942544/6300978111"/>
</LinearLayout>
